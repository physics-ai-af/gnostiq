[Unit]
Description=Gnostiq API and web page
After=network-online.target
Wants=network-online.target

[Service]
User=gnostiq
WorkingDirectory=/opt/gnostiq/app
ExecStart=/opt/gnostiq/app/.venv/bin/gnostiq serve --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
