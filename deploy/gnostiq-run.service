[Unit]
Description=Gnostiq live forecast
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=gnostiq
WorkingDirectory=/opt/gnostiq/app
EnvironmentFile=-/etc/gnostiq.env
ExecStart=/opt/gnostiq/app/.venv/bin/gnostiq run --all-sites
# a dry run until AUTO_DRIVE_API_KEY is set in /etc/gnostiq.env
ExecStart=-/opt/gnostiq/app/.venv/bin/gnostiq publish --all-sites
